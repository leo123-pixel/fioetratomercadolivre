/// Execução de rotina periódica: LISTINGS_RECONCILE | MISSED_FEEDS | ORDERS_RECOVERY.
model SyncJob {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           String
  /// scheduler | manual | cron
  trigger        String
  /// RUNNING | COMPLETED | PARTIAL | FAILED
  status         String    @default("RUNNING")
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  totalProcessed Int       @default(0) @map("total_processed")
  totalChanged   Int       @default(0) @map("total_changed")
  totalFailed    Int       @default(0) @map("total_failed")
  details        Json?
  errorMessage   String?   @map("error_message")

  snapshots ListingSnapshot[]

  @@index([type, startedAt(sort: Desc)], map: "marketplace_sync_jobs_type_started_idx")
  @@map("marketplace_sync_jobs")
}

/// Histórico dos valores lidos no ML (gravado quando algo muda).
model ListingSnapshot {
  id                     BigInt    @id @default(autoincrement())
  listingId              Int       @map("listing_id")
  marketplaceItemId      String    @map("marketplace_item_id")
  marketplaceStatus      String?   @map("marketplace_status")
  marketplaceSubstatus   Json?     @map("marketplace_substatus")
