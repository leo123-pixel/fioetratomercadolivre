  @@map("marketplace_listing_snapshots")
}

/// Divergência entre o integrador e o ML. Única por (item, tipo) enquanto aberta (índice parcial na migration).
model ReconciliationIssue {
  id                BigInt    @id @default(autoincrement())
  marketplaceItemId String    @map("marketplace_item_id")
  listingId         Int?      @map("listing_id")
  /// STATUS_DIVERGENCE | CLOSED_REMOTE | REMOVED_REMOTE | PRICE_DIVERGENCE | QUANTITY_DIVERGENCE | NOT_LINKED | INCOMPLETE_LINK | FETCH_ERROR
  issueType         String    @map("issue_type")
  localValue        String?   @map("local_value")
  remoteValue       String?   @map("remote_value")
  details           Json?
