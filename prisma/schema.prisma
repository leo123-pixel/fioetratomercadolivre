generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MeliConnectionStatus {
  ACTIVE
  REAUTH_REQUIRED
  DISCONNECTED
}

/// Estado temporário do fluxo OAuth (anti-CSRF + PKCE). Uso único, com expiração.
/// Nunca armazena o `state` em claro: apenas o SHA-256.
model OAuthState {
  id              String    @id @default(cuid())
  stateHash       String    @unique @map("state_hash")
  /// SHA-256 do nonce gravado em cookie HttpOnly no navegador que iniciou o fluxo.
  bindingHash     String    @map("binding_hash")
  /// code_verifier PKCE criptografado (AES-256-GCM). Nulo quando PKCE está desabilitado.
  codeVerifierEnc String?   @map("code_verifier_enc")
  expiresAt       DateTime  @map("expires_at")
  consumedAt      DateTime? @map("consumed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oauth_states")
}

/// Conta vendedora conectada. Tokens sempre criptografados em repouso.
model MeliConnection {
  id                   String               @id @default(cuid())
  meliUserId           String               @unique @map("meli_user_id")
  nickname             String?
  siteId               String?              @map("site_id")
  accessTokenEnc       String?              @map("access_token_enc")
  refreshTokenEnc      String?              @map("refresh_token_enc")
  accessTokenExpiresAt DateTime?            @map("access_token_expires_at")
  scope                String?
  status               MeliConnectionStatus @default(ACTIVE)
  /// Incrementado a cada gravação de tokens (rotação do refresh token).
  tokenVersion         Int                  @default(0) @map("token_version")
  /// Lease distribuído para impedir renovações concorrentes entre instâncias.
  refreshLockId        String?              @map("refresh_lock_id")
  refreshLockUntil     DateTime?            @map("refresh_lock_until")
  lastConnectedAt      DateTime?            @map("last_connected_at")
  lastRefreshedAt      DateTime?            @map("last_refreshed_at")
  lastErrorCode        String?              @map("last_error_code")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  @@map("meli_connections")
}

/// Limite de tentativas de login do administrador (por hash do IP).
model AdminLoginThrottle {
  keyHash     String    @id @map("key_hash")
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("admin_login_throttle")
}

// ---------------------------------------------------------------------------
// Fase 2 — Catálogo ADS, preços, estoque, imagens e rascunhos de anúncio.
// Estes dados são lidos e gravados via SQL parametrizado (src/lib/catalog/*) por causa
// dos UPSERTs em lote; os modelos existem aqui para versionar o esquema.
// Constraints CHECK e índices parciais ficam na migration SQL.
// ---------------------------------------------------------------------------

/// Fornecedores da ADS (GET /fornecedores). Somente identificação; sem dados de contato.
model AdsSupplier {
  id        Int      @id
  name      String
  tradeName String?  @map("trade_name")
  inactive  Boolean  @default(false)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("ads_suppliers")
}

/// Divisões da ADS (GET /divisoes).
model AdsDivision {
  code        String   @id
  description String
  inactive    Boolean  @default(false)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("ads_divisions")
}

/// Cadastro de produtos importado da ADS. name_custom nunca é tocado pela importação.
model Product {
  id               Int       @id @default(autoincrement())
  adsProductId     Int       @unique @map("ads_product_id")
  nameOriginal     String    @map("name_original")
  nameCustom       String?   @map("name_custom")
  manufacturerCode String?   @map("manufacturer_code")
  ean              String?
  dun14            String?
  ncm              String?
  supplierId       Int?      @map("supplier_id")
  divisionId       String?   @map("division_id")
  presentation     String?
  unit             String?
  packageQty       Int?      @map("package_qty")
  grossWeight      Decimal?  @map("gross_weight") @db.Decimal(12, 4)
  netWeight        Decimal?  @map("net_weight") @db.Decimal(12, 4)
  width            Decimal?  @db.Decimal(12, 4)
  height           Decimal?  @db.Decimal(12, 4)
  length           Decimal?  @db.Decimal(12, 4)
  inactive         Boolean   @default(false)
  b2b              Boolean?
  /// Referência de imagem no ERP (pode ser um caminho de rede). Nunca usada como URL.
  erpImageRef      String?   @map("erp_image_ref")
  adsUpdatedAt     DateTime? @map("ads_updated_at") @db.Timestamptz(3)
  rawPayload       Json      @map("raw_payload")
  importedAt       DateTime  @default(now()) @map("imported_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  customUpdatedAt  DateTime? @map("custom_updated_at") @db.Timestamptz(3)

  prices ProductPrice[]
  stocks ProductStock[]
  images   ProductImage[]
  draft    ListingDraft?
  listings MarketplaceListing[]

  @@index([supplierId])
  @@index([divisionId])
  @@index([ean])
  @@index([manufacturerCode])
  @@map("products")
}

/// Tabelas comerciais (GET /tabelas). `code` é a referência usada nos preços.
model PriceTable {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  description  String
  base         String?
  expense      Decimal?  @db.Decimal(12, 4)
  commission   Decimal?  @db.Decimal(12, 4)
  profit       Decimal?  @db.Decimal(12, 4)
  freight      Decimal?  @db.Decimal(12, 4)
  markup       Decimal?  @db.Decimal(12, 4)
  isNormal     Boolean   @default(false) @map("is_normal")
  inactive     Boolean   @default(false)
  adsUpdatedAt DateTime? @map("ads_updated_at") @db.Timestamptz(3)
  rawPayload   Json      @map("raw_payload")
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("price_tables")
}

/// Preço por filial + produto + tabela (GET /tabela-precos-itens). Valores comerciais originais.
model ProductPrice {
  id              BigInt    @id @default(autoincrement())
  productId       Int       @map("product_id")
  adsProductId    Int       @map("ads_product_id")
  branchId        String    @map("branch_id")
  priceTableCode  String    @map("price_table_code")
  price           Decimal?  @db.Decimal(14, 4)
  discount        Decimal?  @db.Decimal(12, 4)
  commission      Decimal?  @db.Decimal(12, 4)
  ceilingValue    Decimal?  @map("ceiling_value") @db.Decimal(14, 4)
  pvs             Decimal?  @db.Decimal(14, 4)
  minimumQuantity Decimal?  @map("minimum_quantity") @db.Decimal(14, 3)
  inactive        Boolean   @default(false)
  promotion       Boolean   @default(false)
  adsUpdatedAt    DateTime? @map("ads_updated_at") @db.Timestamptz(3)
  rawPayload      Json      @map("raw_payload")
  fetchedAt       DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([adsProductId, branchId, priceTableCode])
  @@index([productId, priceTableCode])
  @@index([priceTableCode])
  @@map("product_prices")
}

/// Saldo por filial (GET /estoques). Ausência de linha = estoque desconhecido (nunca zero).
model ProductStock {
  id           BigInt    @id @default(autoincrement())
  productId    Int       @map("product_id")
  adsProductId Int       @map("ads_product_id")
  branchId     String    @map("branch_id")
  quantity     Decimal   @db.Decimal(14, 3)
  /// ultVnd da ADS: aparentemente a data da última venda, não a data do saldo.
  lastSaleAt   DateTime? @map("last_sale_at") @db.Timestamptz(3)
  rawPayload   Json      @map("raw_payload")
  /// Momento em que o integrador consultou a ADS.
  fetchedAt    DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([adsProductId, branchId])
  @@index([productId])
  @@map("product_stocks")
}

/// Imagens adicionadas manualmente (Supabase Storage). Independentes da importação ADS.
model ProductImage {
  id               Int      @id @default(autoincrement())
  productId        Int      @map("product_id")
  storagePath      String   @unique @map("storage_path")
  publicUrl        String   @map("public_url")
  contentType      String   @map("content_type")
  sizeBytes        Int      @map("size_bytes")
  width            Int?
  height           Int?
  originalFilename String?  @map("original_filename")
  position         Int      @default(0)
  isPrimary        Boolean  @default(false) @map("is_primary")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// ID retornado por POST /pictures/items/upload (evita reenviar a mesma imagem).
  mlPictureId      String?   @map("ml_picture_id")
  mlPictureAt      DateTime? @map("ml_picture_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

/// Rascunho de anúncio (um por produto). Nada aqui publica no Mercado Livre.
model ListingDraft {
  id                    Int      @id @default(autoincrement())
  productId             Int      @unique @map("product_id")
  title                 String?
  description           String?
  selectedPriceTable    String?  @map("selected_price_table")
  selectedBranchId      String?  @map("selected_branch_id")
  /// Snapshot do preço da tabela selecionada no momento em que o rascunho foi salvo.
  referencePrice        Decimal? @map("reference_price") @db.Decimal(14, 4)
  /// Preço definido/confirmado pelo operador.
  listingPrice          Decimal? @map("listing_price") @db.Decimal(14, 2)
  listingQuantity       Int?     @map("listing_quantity")
  marketplaceCategoryId String?  @map("marketplace_category_id")
  marketplaceAttributes Json     @default("[]") @map("marketplace_attributes")
  /// DRAFT | INCOMPLETE | READY | VALIDATING | VALIDATED | PUBLISHING | PUBLISHED | FAILED | UNKNOWN | ARCHIVED
  status                String   @default("DRAFT")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  // --- Fase 3: preparação e publicação ---
  /// Incrementada a cada alteração; a publicação exige a versão validada.
  version               Int       @default(1)
  categoryName          String?   @map("category_name")
  /// Nome de família (modelo User Products). No modelo clássico usa-se `title`.
  familyName            String?   @map("family_name")
  listingTypeId         String?   @map("listing_type_id")
  itemCondition         String?   @default("new") @map("item_condition")
  /// Termos de venda (ex.: WARRANTY_TYPE / WARRANTY_TIME).
  saleTerms             Json      @default("[]") @map("sale_terms")
  /// Produto de catálogo escolhido pelo operador (nunca vinculado automaticamente).
  catalogProductId      String?   @map("catalog_product_id")
  catalogListing        Boolean   @default(false) @map("catalog_listing")
  validatedVersion      Int?      @map("validated_version")
  validatedFingerprint  String?   @map("validated_fingerprint")
  validatedAt           DateTime? @map("validated_at") @db.Timestamptz(3)
  validationResult      Json?     @map("validation_result")
  lastError             String?   @map("last_error")

  product  Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  listing  MarketplaceListing?
  jobs     PublicationJob[]
  events   ListingEvent[]

  @@index([status])
  @@map("listing_drafts")
}

/// Anúncio criado no Mercado Livre (somente após resposta confirmada da API ou conciliação).
model MarketplaceListing {
  id                   Int       @id @default(autoincrement())
  productId            Int       @map("product_id")
  adsProductId         Int       @map("ads_product_id")
  listingDraftId       Int       @unique @map("listing_draft_id")
  marketplaceAccountId String    @map("marketplace_account_id")
  marketplaceItemId    String    @unique @map("marketplace_item_id")
  userProductId        String?   @map("user_product_id")
  familyId             String?   @map("family_id")
  categoryId           String    @map("category_id")
  listingType          String?   @map("listing_type")
  price                Decimal   @db.Decimal(14, 2)
  quantity             Int
  /// Situação informada pelo Mercado Livre (active, paused, under_review...).
  status               String
  permalink            String?
  descriptionStatus    String?   @map("description_status")
  publishedAt          DateTime  @default(now()) @map("published_at") @db.Timestamptz(3)
  lastSyncedAt         DateTime? @map("last_synced_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  draft   ListingDraft @relation(fields: [listingDraftId], references: [id], onDelete: Restrict)
  events  ListingEvent[]

  @@unique([productId, marketplaceAccountId])
  @@index([adsProductId])
  @@map("marketplace_listings")
}

/// Pedido de publicação confirmado pelo administrador. Idempotente por `idempotencyKey`.
model PublicationJob {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingDraftId  Int       @map("listing_draft_id")
  productId       Int       @map("product_id")
  accountId       String    @map("account_id")
  batchId         String?   @map("batch_id") @db.Uuid
  /// QUEUED | RUNNING | SUCCEEDED | FAILED | UNKNOWN | CANCELED
  status          String    @default("QUEUED")
  requestedBy     String    @map("requested_by")
  draftVersion    Int       @map("draft_version")
  fingerprint     String
  idempotencyKey  String    @unique @map("idempotency_key")
  attemptCount    Int       @default(0) @map("attempt_count")
  reconcileCount  Int       @default(0) @map("reconcile_count")
  /// Momento em que o POST /items foi enviado (write-ahead para conciliação).
  createSentAt    DateTime? @map("create_sent_at") @db.Timestamptz(3)
  nextRunAt       DateTime  @default(now()) @map("next_run_at") @db.Timestamptz(3)
  marketplaceItemId String? @map("marketplace_item_id")
  errorCode       String?   @map("error_code")
  errorMessage    String?   @map("error_message")
  startedAt       DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  draft    ListingDraft         @relation(fields: [listingDraftId], references: [id], onDelete: Restrict)
  attempts PublicationAttempt[]

  @@index([status, nextRunAt])
  @@index([batchId])
  @@map("marketplace_publication_jobs")
}

/// Cada chamada ao Mercado Livre feita por um job (requisição e resposta sanitizadas).
model PublicationAttempt {
  id                 BigInt   @id @default(autoincrement())
  publicationJobId   String   @map("publication_job_id") @db.Uuid
  requestId          String   @map("request_id")
  operation          String
  sanitizedRequest   Json?    @map("sanitized_request")
  sanitizedResponse  Json?    @map("sanitized_response")
  httpStatus         Int?     @map("http_status")
  errorCode          String?  @map("error_code")
  errorMessage       String?  @map("error_message")
  durationMs         Int?     @map("duration_ms")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  job PublicationJob @relation(fields: [publicationJobId], references: [id], onDelete: Cascade)

  @@index([publicationJobId, createdAt])
  @@map("marketplace_publication_attempts")
}

/// Cache de categorias, atributos e especificações técnicas do Mercado Livre.
model CategoryCache {
  id                 Int      @id @default(autoincrement())
  categoryId         String   @unique @map("category_id")
  categoryName       String?  @map("category_name")
  categoryJson       Json?    @map("category_json")
  attributesJson     Json?    @map("attributes_json")
  technicalSpecsJson Json?    @map("technical_specs_json")
  fetchedAt          DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(3)

  @@map("marketplace_category_cache")
}

/// Trilha de auditoria de rascunhos, publicações e anúncios.
model ListingEvent {
  id             BigInt   @id @default(autoincrement())
  listingDraftId Int      @map("listing_draft_id")
  listingId      Int?     @map("listing_id")
  jobId          String?  @map("job_id") @db.Uuid
  eventType      String   @map("event_type")
  previousStatus String?  @map("previous_status")
  newStatus      String?  @map("new_status")
  details        Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  draft   ListingDraft        @relation(fields: [listingDraftId], references: [id], onDelete: Cascade)
  listing MarketplaceListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([listingDraftId, createdAt])
  @@map("marketplace_listing_events")
}

/// Tarefa persistente de importação, processada em fatias por um worker com lease.
model ImportJob {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// PRODUCTS | PRICE_TABLES | PRICES | STOCKS (CHECK na migration)
  type         String
  /// PENDING | RUNNING | COMPLETED | PARTIALLY_COMPLETED | FAILED | CANCELED
  status       String    @default("PENDING")
  /// Filtro opcional, ex.: { "adsProductIds": [1804] }
  params       Json      @default("{}")
  /// Posição de retomada: { phase, page, chunk }
  cursor       Json      @default("{}")
  total        Int?
  processed    Int       @default(0)
  created      Int       @default(0)
  updated      Int       @default(0)
  unchanged    Int       @default(0)
  failed       Int       @default(0)
  attempts     Int       @default(0)
  nextRunAt    DateTime  @default(now()) @map("next_run_at") @db.Timestamptz(3)
  lastError    String?   @map("last_error")
  startedAt    DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(3)
  errorSummary String?   @map("error_summary")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  errors ImportJobError[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("import_jobs")
}

model ImportJobError {
  id                BigInt   @id @default(autoincrement())
  importJobId       String   @map("import_job_id") @db.Uuid
  externalProductId Int?     @map("external_product_id")
  page              Int?
  errorCode         String   @map("error_code")
  errorMessage      String   @map("error_message")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  job ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId, createdAt])
  @@map("import_job_errors")
}

/// Lease global do worker de importação: uma única fatia consulta a ADS por vez.
model WorkerLease {
  name       String   @id
  owner      String
  leaseUntil DateTime @map("lease_until") @db.Timestamptz(3)

  @@map("worker_leases")
}

/// Configurações administrativas (ex.: tabela de preço de referência).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}
