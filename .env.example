# ------------------------------------------------------------------
# Fio & Trato - Integrador Mercado Livre
# Copie para .env.local (dev) ou cadastre na Vercel (Settings > Environment Variables).
# NUNCA versione valores reais.
# ------------------------------------------------------------------

# App ID e Secret Key da aplicação "Fio e Trato - MELI" (Mercado Livre Developers > Minhas aplicações)
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=

# Deve ser EXATAMENTE igual à URI cadastrada no DevCenter, sem parâmetros variáveis.
# Formato: https://<dominio-real>/api/auth/mercadolivre/callback
MELI_REDIRECT_URI=

# true se o fluxo PKCE estiver habilitado na aplicação no DevCenter (envia code_challenge S256)
MELI_PKCE_ENABLED=true

# PostgreSQL (Supabase, Neon, Vercel Postgres...). Em Supabase use a connection string do pooler.
DATABASE_URL=

# 32 bytes aleatórios em base64 (AES-256-GCM dos tokens em repouso). Gere com: npm run keys:generate
TOKEN_ENCRYPTION_KEY=

# URL pública da aplicação, sem barra final. Ex.: https://<dominio-real>
APP_BASE_URL=

# --- Autenticação administrativa do integrador ---
# Hash scrypt da senha do administrador. Gere com: npm run admin:hash
ADMIN_PASSWORD_HASH=
# Segredo (>= 32 caracteres) para assinar o cookie de sessão. Gere com: npm run keys:generate
# Também deriva o token interno do worker de importação.
SESSION_SECRET=

# ------------------------------------------------------------------
# Fase 2 - ADS API (Tecdisa). Somente leitura. Credenciais apenas no servidor.
# ------------------------------------------------------------------
# Homologação: https://hom.adsapi.com.br (padrão). Produção: URL informada pela Tecdisa.
ADS_API_BASE_URL=https://hom.adsapi.com.br
# Chave enviada no cabeçalho x-api-key (Sensitive na Vercel)
ADS_API_KEY=
# CNPJ da distribuidora usado na rota /api/v1/{cnpj}/... (só dígitos ou com pontuação)
ADS_CNPJ=
# Valor do cabeçalho User-Agent exigido pela ADS (o mesmo validado no Postman)
ADS_USER_AGENT=
# Opcionais
# ADS_PAGE_SIZE=50          # itens por página (1-500)
# ADS_MIN_INTERVAL_MS=300   # intervalo mínimo entre requisições à ADS
# ADS_TIMEOUT_MS=20000      # timeout por requisição
# ADS_RETRY_BASE_MS=2000    # base do backoff exponencial (máx. 30 s, 5 tentativas por página)
# ADS_BRANCH_CNPJ=          # cnpjfilial para filtrar o estoque por filial

# ------------------------------------------------------------------
# Fase 2 - Imagens (Supabase Storage). O bucket público é criado automaticamente.
# ------------------------------------------------------------------
# Ex.: https://<ref-do-projeto>.supabase.co
SUPABASE_URL=
# Chave service_role / secret (Sensitive na Vercel). Nunca exposta ao navegador.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Opcional: protege a chamada diária do Vercel Cron que retoma importações paradas.
# CRON_SECRET=

# ------------------------------------------------------------------
# Fases 4/5 - Notificações, sincronização e pedidos (todas opcionais; padrões entre parênteses)
# ------------------------------------------------------------------
# Usado pelo Vercel Cron (diário) nas rotas /api/import/worker e /api/marketplace/scheduler/tick.
# Sem ele, os crons da Vercel recebem 401 (o agendador principal é o pg_cron do Supabase).
# CRON_SECRET=
# MELI_SYNC_INTERVAL_MINUTES=5               # reconciliação de anúncios (o pg_cron dispara a cada 5 min)
# MELI_MISSED_FEEDS_INTERVAL_MINUTES=60      # recuperação de notificações perdidas (o ML guarda por 2 dias)
# MELI_ORDERS_RECOVERY_INTERVAL_MINUTES=30   # varredura de pedidos atualizados recentemente
# MELI_ORDERS_RECOVERY_WINDOW_HOURS=48
# MELI_EVENT_MAX_ATTEMPTS=8                  # tentativas por evento antes do dead-letter (FAILED)
# MELI_EVENT_RETENTION_DAYS=90               # eventos concluídos/ignorados mais antigos são apagados
# ORDER_RAW_RETENTION_DAYS=180               # retenção do JSON original dos pedidos (LGPD)
# MELI_BACKLOG_ALERT_MINUTES=30              # alerta quando há evento pendente há mais tempo que isso
# MELI_WEBHOOK_ALLOWED_IPS=                  # lista separada por vírgula; vazio = aceita qualquer origem
# ALERT_WEBHOOK_URL=                         # https opcional que recebe alertas administrativos (POST JSON)
