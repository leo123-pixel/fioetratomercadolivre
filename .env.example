# ------------------------------------------------------------------
# Fio & Trato - Integrador Mercado Livre
# Copie para .env.local (dev) ou cadastre na Vercel (Settings > Environment Variables).
# NUNCA versione valores reais.
# ------------------------------------------------------------------

# App ID e Secret Key da aplicação "Fio e Trato - MELI" (Mercado Livre Developers > Minhas aplicações)
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=

# Deve ser EXATAMENTE igual à URI cadastrada no DevCenter, sem parâmetros variáveis.
# Formato: https://<dominio-real>/api/auth/mercadolivre/callback
MELI_REDIRECT_URI=

# true se o fluxo PKCE estiver habilitado na aplicação no DevCenter (envia code_challenge S256)
MELI_PKCE_ENABLED=true

# PostgreSQL (Supabase, Neon, Vercel Postgres...). Em Supabase use a connection string do pooler.
DATABASE_URL=

# 32 bytes aleatórios em base64 (AES-256-GCM dos tokens em repouso). Gere com: npm run keys:generate
TOKEN_ENCRYPTION_KEY=

# URL pública da aplicação, sem barra final. Ex.: https://<dominio-real>
APP_BASE_URL=

# --- Autenticação administrativa do integrador ---
# Hash scrypt da senha do administrador. Gere com: npm run admin:hash
ADMIN_PASSWORD_HASH=
# Segredo (>= 32 caracteres) para assinar o cookie de sessão. Gere com: npm run keys:generate
SESSION_SECRET=
